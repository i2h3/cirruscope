    "NSCameraUsageDescription" : {
      "comment" : "Reason shown in the system permission prompt asking to use the camera, presented the first time the web interface requests camera access for a video call.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff auf deine Kamera, um dich während Videoanrufen zu zeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant access to your camera to show yourself during video calls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concede acceso a tu cámara para mostrarte durante las videollamadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise l'accès à ta caméra pour te montrer pendant les appels vidéo."
