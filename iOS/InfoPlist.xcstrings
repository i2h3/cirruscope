    "NSLocalNetworkUsageDescription" : {
      "comment" : "Reason shown in the system permission prompt asking to reach devices on the local network, presented the first time the app connects to a server hosted there.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff, um Verbindungen zu Servern in deinem lokalen Netzwerk herzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant access to allow connections to servers in your local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concede acceso para permitir conexiones a servidores de tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise l'accès afin de permettre les connexions aux serveurs de ton réseau local."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Reason shown in the system permission prompt asking to use the microphone, presented the first time the web interface requests microphone access for a call.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff auf dein Mikrofon, um während Videoanrufen frei zu sprechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant access to your microphone to speak freely during video calls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concede acceso a tu micrófono para hablar libremente durante las videollamadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise l'accès à ton microphone pour parler librement pendant les appels vidéo."
