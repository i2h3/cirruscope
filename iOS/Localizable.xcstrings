    "Assuming HTTPS for a secure connection unless specified differently." : {
      "comment" : "Caption under the server address field on the iOS sign-in screen, naming the HTTPS default the app applies to an address entered without a scheme of its own.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS wird für eine sichere Verbindung angenommen, sofern nicht anders angegeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se asume HTTPS para una conexión segura, salvo que se indique lo contrario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS est utilisé pour une connexion sécurisée, sauf indication contraire."
          }
        }
      }
    },
    "Cirruscope can only connect to a Nextcloud server over HTTP or HTTPS, not “%@”." : {
      "comment" : "Error shown when the entered server address uses a scheme other than HTTP or HTTPS; the placeholder is that scheme.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope kann sich nur über HTTP oder HTTPS mit einem Nextcloud-Server verbinden, nicht über “%@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope solo puede conectarse a un servidor Nextcloud mediante HTTP o HTTPS, no mediante “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope ne peut se connecter à un serveur Nextcloud qu'en HTTP ou HTTPS, pas en “%@”."
          }
        }
      }
    },
    "Cirruscope requires Nextcloud server version %lld or later. The server at “%@” is running version %@." : {
      "comment" : "Alert message shown when the server's Nextcloud version is too old; placeholders are the minimum supported major version, the server address, and the server's version.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope erfordert Nextcloud-Serverversion %lld oder neuer. Der Server unter “%@” verwendet Version %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope requiere la versión %lld o posterior del servidor Nextcloud. El servidor en “%@” está ejecutando la versión %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope requiert la version %lld ou ultérieure du serveur Nextcloud. Le serveur à l'adresse “%@” exécute la version %@."
          }
        }
      }
    },
