    {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/WebKit.framework", "target-membership": [ "macOS/frameworks" ] },
        { "path": "<DEVELOPER>/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS26.5.sdk/System/Library/Frameworks/WebKit.framework", "target-membership": [ "iOS/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "Widgets/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "Widgets/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Cirruscope.app", "id": "AA059CA32FE407A700DE3094", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/macOSTests.xctest", "id": "AA2AC5D530189B11002A0C28", "type": "wrapper.cfbundle", "index": false },
