        "ENABLE_RESOURCE_ACCESS_PHOTO_LIBRARY": "NO",
        "ENABLE_RESOURCE_ACCESS_PRINTING": "NO",
        "ENABLE_RESOURCE_ACCESS_USB": "NO",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_NSCameraUsageDescription": "Grant access to your camera to show yourself during video calls.",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "Grant access to allow connections to servers in your local network.",
        "INFOPLIST_KEY_NSMainStoryboardFile": "Main",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Grant access to your microphone to speak freely during video calls.",
        "INFOPLIST_KEY_NSPrincipalClass": "NSApplication",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "RUNTIME_EXCEPTION_ALLOW_DYLD_ENVIRONMENT_VARIABLES": "NO",
        "RUNTIME_EXCEPTION_ALLOW_JIT": "NO",
        "RUNTIME_EXCEPTION_ALLOW_UNSIGNED_EXECUTABLE_MEMORY": "NO",
        "RUNTIME_EXCEPTION_DEBUGGING_TOOL": "NO",
        "RUNTIME_EXCEPTION_DISABLE_EXECUTABLE_PAGE_PROTECTION": "NO",
        "RUNTIME_EXCEPTION_DISABLE_LIBRARY_VALIDATION": "NO",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
