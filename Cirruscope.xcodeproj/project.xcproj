      "id": "AA059CA22FE407A700DE3094",
      "product": "id:AA059CA32FE407A700DE3094",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": { "anchor": "macOS", "relative-path": "macOS.xcconfig" } },
