// Configuration settings file format documentation can be found at:
// https://developer.apple.com/documentation/xcode/adding-a-build-configuration-file-to-your-project

#include "../Cirruscope.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(CIRRUSCOPE_BASE_BUNDLE_IDENTIFIER)
PRODUCT_NAME = $(CIRRUSCOPE_BUNDLE_NAME)

// The entitlements are assigned here, after the include of the root, rather than in the root itself: the two test
// bundles include only the root and so carry none, and a root `Local.xcconfig`, read before this point, cannot
// reassign them for the apps. `Widgets/Widgets.xcconfig` assigns the same entitlements to the extension the same way.
// `REGISTER_APP_GROUPS` is a macOS-only build setting, letting automatic signing register the App Group the
// entitlements name when it signs for the Mac, and it sits beside them here rather than in `project.pbxproj`.
CODE_SIGN_ENTITLEMENTS = Cirruscope/Cirruscope.entitlements
REGISTER_APP_GROUPS = YES

#include? "Local.xcconfig"
