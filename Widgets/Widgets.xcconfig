// Configuration settings file format documentation can be found at:
// https://developer.apple.com/documentation/xcode/adding-a-build-configuration-file-to-your-project

#include "../Cirruscope.xcconfig"

// An app extension sits at a different depth inside an iOS `.app` than inside a macOS `.app/Contents`, so the two
// runpaths differ. Both values are Apple's own, taken from the multiplatform app extension template. Neither side is
// written unconditionally: `$(inherited)` in a qualified assignment picks up the unqualified one from this same file,
// so a macOS build would otherwise resolve to both sets of paths at once.
LD_RUNPATH_SEARCH_PATHS[sdk=iphone*] = $(inherited) @executable_path/Frameworks @executable_path/../../Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks @executable_path/../../../../Frameworks
PRODUCT_BUNDLE_IDENTIFIER = $(CIRRUSCOPE_BASE_BUNDLE_IDENTIFIER).widgets

// The same entitlements as the apps: the App Group is what the extension reaches the apps' data through, and the
// Keychain access group is what it reads their credentials through, on both platforms, because the credentials are in
// the data-protection Keychain on macOS as well, the one Keychain where an access group decides who may read an item.
// They are assigned here, after the include of the root, as `Cirruscope/Cirruscope.xcconfig` assigns them to the apps.
// `REGISTER_APP_GROUPS` is a macOS-only build setting, letting automatic signing register the App Group the
// entitlements name when it signs for the Mac, and it sits beside them here rather than in `project.pbxproj`.
CODE_SIGN_ENTITLEMENTS = Cirruscope/Cirruscope.entitlements
REGISTER_APP_GROUPS = YES

// `auto` is what lets a single extension target serve both apps: the SDK follows whichever platform is being built,
// instead of the project-wide `macosx`. The platform and device family lists are trimmed from the template's
// `xros xrsimulator` and `1,2,7`, because no visionOS app embeds this extension and a platform nothing builds is a
// platform that rots.
SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
TARGETED_DEVICE_FAMILY = 1,2

// Two files beside this one are rewritten by Xcode and carry no comments, so what they hold on purpose is noted here.
// `Info.plist` deliberately declares no `NSLocalNetworkUsageDescription`, although the extension reaches the server
// itself: an app extension shares its containing app's local network permission, and the reason belongs in the app's
// property list alone. `PrivacyInfo.xcprivacy` is the extension's own privacy manifest, since the extension is a
// bundle of its own and the apps' copy in `Cirruscope/` does not reach it: it declares the file-timestamp APIs that
// `Core/` and Rainmaker compile into the extension as well.

#include? "Local.xcconfig"
