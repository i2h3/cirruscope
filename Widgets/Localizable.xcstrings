{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ and %lld more" : {
      "comment" : "Names a file together with how many further files the server merged into the same activity, in the widget. The first placeholder is the file's name, emphasized; the second is how many further files there were.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ und %2$lld weitere"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ y %2$lld más"
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ et %2$lld autre"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ et %2$lld autres"
                }
              }
            }
          }
        }
      }
    },
    "Activity" : {
      "comment" : "The widget's name, used both in the gallery somebody picks widgets from and as the heading above the activity it lists. The heading is drawn in capitals, which the app applies itself, so translate this in sentence case — and as a word rather than a transliteration.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivität"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actividad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activité"
          }
        }
      }
    },
    "Activity unavailable" : {
      "comment" : "Headline on the widget when the server's activity app is switched off, so there is nothing for it to list.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivität nicht verfügbar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actividad no disponible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activité indisponible"
          }
        }
      }
    },
    "All quiet" : {
      "comment" : "Headline on the widget when the server reports no recent file activity at all. Calm rather than literal: it means nothing has happened, and that is fine.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles ruhig"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo en calma"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à signaler"
          }
        }
      }
    },
    "Can't reach server · shown %@" : {
      "comment" : "Footnote on the widget when the server could not be reached, so the activity shown is older than it should be. The placeholder is how long ago it was read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server nicht erreichbar · %@ geladen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidor no disponible · datos de %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveur injoignable · actualisé %@"
          }
        }
      }
    },
    "No file changes to show." : {
      "comment" : "The sentence beneath the widget's “All quiet” headline.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Dateiänderungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cambios que mostrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune modification de fichier à afficher."
          }
        }
      }
    },
    "Not signed in" : {
      "comment" : "Headline on the widget when no Nextcloud account has been added yet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht angemeldet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesión no iniciada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non connecté"
          }
        }
      }
    },
    "Open Cirruscope" : {
      "comment" : "Label of the button on the widget inviting somebody to open the app and add an account. Cirruscope is the application's own name and is not translated.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope öffnen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir Cirruscope"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir Cirruscope"
          }
        }
      }
    },
    "Open Cirruscope to add your Nextcloud server." : {
      "comment" : "The sentence beneath the widget's “Not signed in” headline.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie Cirruscope, um Ihren Nextcloud-Server hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Cirruscope para añadir tu servidor Nextcloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Cirruscope pour ajouter votre serveur Nextcloud."
          }
        }
      }
    },
    "Recent changes to the files on your Nextcloud server." : {
      "comment" : "The widget's description in the gallery somebody picks widgets from.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neueste Änderungen an den Dateien auf Ihrem Nextcloud-Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambios recientes en los archivos de tu servidor Nextcloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifications récentes des fichiers de votre serveur Nextcloud."
          }
        }
      }
    },
    "Stale" : {
      "comment" : "Marks the widget's activity list as older than it should be, because the server could not be reached. Drawn in capitals, which the app applies itself, so translate this in sentence case.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veraltet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsoleta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsolète"
          }
        }
      }
    },
    "The login credentials could not be stored in the keychain (status %d)." : {
      "comment" : "Error shown when storing credentials in the keychain failed; the placeholder is the numeric OSStatus.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldedaten konnten nicht im Schlüsselbund gespeichert werden (Status %d)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron guardar las credenciales de inicio de sesión en el llavero (estado %d)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identifiants de connexion n'ont pas pu être enregistrés dans le trousseau (statut %d)."
          }
        }
      }
    },
    "The login timed out before it was completed. Please try again." : {
      "comment" : "Error shown when the login was not completed within the allowed time.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung ist abgelaufen, bevor sie abgeschlossen wurde. Bitte versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión caducó antes de completarse. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a expiré avant d'être terminée. Veuillez réessayer."
          }
        }
      }
    },
    "The login was cancelled." : {
      "comment" : "Error shown when the user dismissed the login before completing it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung wurde abgebrochen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión se canceló."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été annulée."
          }
        }
      }
    },
    "The login window could not be opened." : {
      "comment" : "Error shown when the Login Flow v2 authentication window could not be presented.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Anmeldefenster konnte nicht geöffnet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir la ventana de inicio de sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre de connexion n'a pas pu être ouverte."
          }
        }
      }
    },
    "The server returned a response that could not be understood." : {
      "comment" : "Error shown when the server's response was not a valid HTTP response.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat eine Antwort zurückgegeben, die nicht verstanden werden konnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor devolvió una respuesta que no se pudo interpretar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a renvoyé une réponse incompréhensible."
          }
        }
      }
    },
    "The server returned an unexpected status code (%lld)." : {
      "comment" : "Error shown when the server returned an unexpected HTTP status; the placeholder is the numeric status code.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat einen unerwarteten Statuscode zurückgegeben (%lld)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor devolvió un código de estado inesperado (%lld)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a renvoyé un code de statut inattendu (%lld)."
          }
        }
      }
    },
    "This server does not have its activity app switched on." : {
      "comment" : "The sentence beneath the widget's “Activity unavailable” headline. The activity app is a Nextcloud server app named Activity.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Server ist die App „Aktivität“ nicht aktiviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no tiene activada la app Actividad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’application Activité n’est pas activée sur ce serveur."
          }
        }
      }
    }
  },
  "version" : "1.2"
}